{
  "name": "42-exam-trainer",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:python": "node scripts/validate-python.mjs",
    "setup:runtime": "node scripts/copy-runtime.mjs",
    "pretest": "node scripts/export-answers.mjs",
    "prebuild": "node scripts/copy-runtime.mjs",
    "predev": "node scripts/copy-runtime.mjs",
    "desktop": "npm run build && electron .",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs",
    "release:windows": "node scripts/desktop-release.mjs",
    "test:learning": "node scripts/validate-learning.mjs",
    "release:linux": "node scripts/linux-release.mjs",
    "test:answers": "node scripts/validate-answers.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "codemirror": "^6.0.1",
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "main": "electron/main.cjs",
  "description": "Estudo offline dos exercícios de Python Exam Rank 03",
  "author": "42 Examark — projeto comunitário",
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcWav/42-Examark.git"
  }
}
