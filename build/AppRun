#!/bin/sh
set -eu
if [ "$(id -u)" -eq 0 ]; then
    printf '%s\n' 'Abra o 42 Exam Trainer com seu usuário normal, sem sudo.' >&2
    exit 1
fi
app_dir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
if [ -d "$app_dir/usr/lib" ]; then
    export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$app_dir/42-exam-trainer" "$@"
